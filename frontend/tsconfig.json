{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"],
  "exclude": [
    "src/components/CompaniesBrowser.tsx",
    "src/components/CompanyDrilldown.tsx",
    "src/components/DatabaseExplorer.tsx",
    "src/components/SentimentPanel.tsx",
    "src/components/ImpactGraph.tsx",
    "src/components/TradeIdeas.tsx",
    "src/components/NewsFeed.tsx",
    "src/components/Watchlist.tsx",
    "src/hooks/useSentimentFeed.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
