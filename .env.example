# ──────────────────────────────────────────────────────────────
# Bharat Terminal — Environment Configuration
# Copy to .env and fill in your values before running.
# ──────────────────────────────────────────────────────────────

# REQUIRED ─────────────────────────────────────────────────────
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# AUTH (Google OAuth, invite-only) — REQUIRED for the terminal app ──
# Google OAuth *Web* client id from https://console.cloud.google.com/apis/credentials
# Set Authorized JavaScript origins to:
#   https://terminal.taperead.trade   (production)
#   http://localhost:3000             (local dev)
# Used by BOTH the API (verifies Google ID tokens) and the frontend build
# (compose passes it as the VITE_GOOGLE_CLIENT_ID build arg).
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# HS256 signing key for our session cookie. Generate a strong random value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_JWT_SECRET=change-me-to-a-long-random-string
# Days a session cookie stays valid.
SESSION_TTL_DAYS=7
# Set to "false" ONLY for plain-HTTP local dev (otherwise the cookie is Secure).
COOKIE_SECURE=true
# Comma-separated allowed CORS origins (cookie auth needs explicit origins, not *).
# Frontend + API are same-origin behind nginx, so CORS isn't normally exercised;
# listed for safety. Production app is served at https://terminal.taperead.trade.
CORS_ORIGINS=https://terminal.taperead.trade,http://localhost:3000

# OPTIONAL — defaults work for local docker-compose ────────────

# Kafka / Redpanda
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

# PostgreSQL (pgvector)
DATABASE_URL=postgresql+asyncpg://bharat:bharat@postgres:5432/bharat_terminal

# Redis
REDIS_URL=redis://redis:6379/0

# Knowledge Base service (internal)
KB_SERVICE_URL=http://kb-service:8001

# LLM model selection. The wrapper picks the provider from the model id:
#   claude-*  -> Vertex AI (AnthropicVertex)   [LLM_PROVIDER=anthropic uses the console API instead]
#   gemini-*  -> Vertex AI (google-genai)
# Per-stage models can be switched freely (e.g. signals on Gemini, dossier on Opus).
EXTRACTION_MODEL=gemini-2.5-flash
IMPACT_MODEL=gemini-2.5-flash
SIGNALS_MODEL=gemini-3.1-pro-preview
DOSSIER_MODEL=gemini-3.1-pro-preview
# Model used for the dossier agent's web_search (Google Search grounding) tool.
GROUNDING_MODEL=gemini-3.5-flash

# ── MCP server (NSE-grounding tools over streamable HTTP) ───────────────
# Opt-in service (docker compose --profile mcp up -d mcp-server).
MCP_SERVER_PORT=8002

# ── LLM provider / Vertex AI ────────────────────────────────────────────
# LLM_PROVIDER: vertex (default) or anthropic (legacy console API, needs ANTHROPIC_API_KEY)
LLM_PROVIDER=vertex
VERTEX_PROJECT=bharat-terminal
# Claude 4.x and newer Gemini (e.g. gemini-3.5-flash) are served on Vertex's
# "global" endpoint; the dated regional endpoints (us-east5/us-central1) 404 on
# claude-haiku-4-5 / claude-sonnet-4-6 / claude-opus-4-8 / gemini-3.5-flash.
VERTEX_CLAUDE_REGION=global
VERTEX_GEMINI_REGION=global
# Prereqs: grant roles/aiplatform.user to the VM service account, and enable the
# Claude models in Vertex Model Garden. Override a Vertex model id if needed via
# VERTEX_MODEL_<UPPER_SNAKE>, e.g. VERTEX_MODEL_CLAUDE_OPUS_4_8=claude-opus-4-8@<version>

# ── Stage 1 (relevance filter) ──────────────────────────────────────────
# Backend: `local` (default, free, runs on the VM) or `anthropic` (~$0.02/day).
#
#   local      — HuggingFace zero-shot classifier
#                  (MoritzLaurer/deberta-v3-base-zeroshot-v2.0, ~750MB).
#                  ~300-500ms per item on 2vCPU. Pre-baked into the
#                  analysis-worker image at build time.
#   anthropic  — Claude Haiku call. Higher accuracy on edge cases.
RELEVANCE_BACKEND=local
RELEVANCE_MODEL=MoritzLaurer/deberta-v3-base-zeroshot-v2.0
# Score the "market" label must exceed for relevant=True. Softmax over 4
# labels (random baseline = 0.25), so 0.35 means clear plurality winner.
# Tune up for stricter filtering, down to widen the funnel.
RELEVANCE_LOCAL_THRESHOLD=0.35

# Anthropic-backend tuning (only used if RELEVANCE_BACKEND=anthropic)
RELEVANCE_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
RELEVANCE_TIMEOUT_SEC=8

# Shared cache TTL — cross-source dupes and Kafka replays hit cache (~5ms)
# instead of re-classifying. 7 days is fine (a headline's verdict doesn't
# change after the fact).
RELEVANCE_CACHE_TTL_SEC=604800

LLM_LOG_FILE=/tmp/llm_calls.jsonl

# Polymarket adapter tuning
# An event passes the volume gate if EITHER condition is true:
#   vol_24h >= POLYMARKET_MIN_VOLUME_24H   (recently active)
#   vol_total >= POLYMARKET_MIN_VOLUME_TOTAL  (historically liquid)
# The OR prevents long-duration price-ladder markets (e.g. "WTI May 2026",
# ~$10M total) from dropping out on quiet trading days.
POLYMARKET_MIN_VOLUME_24H=1000000
POLYMARKET_MIN_VOLUME_TOTAL=5000000

# ── Angel One SmartAPI — MCX commodity tick feed ──────────────────────
# Required to enable the commodity price-trigger path. Adapter skips
# silently if any of these are missing (dev environments still boot).
# Generate at: https://smartapi.angelbroking.com/ (My Profile → API Keys)
# TOTP secret = the base32 string from your Angel One 2FA QR enrolment.
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_CODE=
ANGEL_ONE_PASSWORD=                # the numeric trading PIN, NOT login password
ANGEL_ONE_TOTP_SECRET=

# Commodity shock detector tuning — defaults are deliberately strict so
# only genuine shocks (~few per week per commodity in normal markets)
# fire signals.
COMMODITY_WINDOW_MIN=10            # rolling-return window (minutes)
COMMODITY_PCT_THRESHOLD=0.012      # |return| floor (1.2%)
COMMODITY_Z_THRESHOLD=3.0          # z-score floor vs. realised vol
COMMODITY_BASELINE_MIN=60          # window for realised-vol baseline
COMMODITY_COOLDOWN_SEC=300         # min seconds between shocks per commodity

# ── Research agent (data-backed beta calibration) ─────────────────────
# The research-runner container reads BSE corporate filings XBRL + uses
# Anthropic web search to derive citation-backed betas, then writes them
# into the `trigger_betas` table. Strict-mode contract: the commodity
# signal generator drops any symbol that has no trigger_betas row.
RESEARCH_MODEL=gemini-3.1-pro-preview
RESEARCH_MAX_TURNS=8               # max tool-use turns per (symbol, trigger) pair
RESEARCH_ENABLE_WEB_SEARCH=1       # 0 to disable Anthropic web_search tool
